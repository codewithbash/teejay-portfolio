---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import { projects } from "../data/projects";
import portrait from "../assets/teejay.png";
import Marquee from "../components/Marquee.astro";

const services = [
  { n: "01", title: "Logo Design", text: "A simple, memorable mark." },
  { n: "02", title: "Brand Identity", text: "Colour, type and guidelines." },
  { n: "03", title: "Flyers & Social", text: "Graphics that get noticed." },
  { n: "04", title: "Event Design", text: "Posters and promo material." },
];

// The four pieces shown on the home page (use the file names, without .jpg)
const featuredSlugs = ["savora-identity", "creativerse-cap", "pearls-bakes", "giants-pulse"];
const featured = featuredSlugs
  .map((slug) => projects.find((p) => p.slug === slug))
  .filter(Boolean);
---
<Layout>
  <!-- Hero -->
  <section class="grid items-center gap-10 px-6 md:px-14 py-12 md:grid-cols-2">
    <div>
      <p class="rise mb-5 text-xs tracking-[2px] text-brand">CREATIVITY · DESIGN · IMPACT</p>
      <h1 class="rise font-serif text-5xl leading-[1.05] md:text-7xl" style="--d:120ms">
        Designing brands that leave <em class="text-brand">a lasting impression.</em>
      </h1>
      <p class="rise my-6 max-w-md text-neutral-600" style="--d:240ms">
        A graphic designer helping businesses look sharp and stand out.
      </p>
      <a href="/work" class="rise inline-block bg-ink px-6 py-3.5 text-sm font-medium text-white active:scale-[0.97] transition-transform" style="--d:360ms">View my work →</a>
    </div>
    <div data-wipe class="flex h-[480px] items-end justify-center overflow-hidden rounded-t-full bg-brand">
		<Image src={portrait} alt="Portrait of Teejay" width={900} class="h-[95%] w-auto object-contain" />
	</div>
  </section>

  <Marquee />

  <!-- Services -->
  <section class="mx-6 md:mx-14 grid border-y border-neutral-300 md:grid-cols-4">
    {services.map((s) => (
      <div class="py-7 pr-5 text-sm text-neutral-600">
        <b class="mb-1.5 block text-base text-ink">{s.title}</b>
        {s.text}
      </div>
    ))}
  </section>

  <!-- Selected projects -->
    <section class="px-6 md:px-14 py-16">
    <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="mb-4 text-xs tracking-[2px] text-brand">PORTFOLIO</p>
        <h2 class="font-serif text-4xl md:text-5xl">Selected projects</h2>
      </div>
      <a href="/work" class="border border-ink px-6 py-3.5 text-sm font-medium transition-all active:scale-[0.97] hover:bg-ink hover:text-white">
        Explore the work →
      </a>
    </div>

    <div class="grid grid-cols-2 gap-4 md:grid-cols-4 md:gap-6">
      {featured.map((p) => (
        <a href="/work" class="group block">
          <div class="relative overflow-hidden bg-tint">
            <Image
              src={p.image}
              alt={p.alt}
              width={700}
              class="aspect-square w-full object-cover transition-transform duration-700 ease-out group-hover:scale-110"
              data-wipe
            />
            <div class="absolute inset-0 hidden flex-col justify-end bg-linear-to-t from-black/75 via-transparent to-transparent p-4 text-white opacity-0 transition-opacity duration-300 group-hover:opacity-100 md:flex">
              <small class="text-[11px] tracking-[2px] text-white/80">{p.category.toUpperCase()}</small>
              <p class="font-serif text-lg">{p.title}</p>
            </div>
          </div>
          <p class="mt-2 text-sm md:hidden">{p.title}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Call to action -->
  <section class="flex flex-wrap items-center justify-between gap-6 bg-tint px-6 md:px-14 py-14">
    <h2 class="font-serif text-4xl">Let's create something amazing together.</h2>
    <a href="/contact" class="bg-ink px-6 py-3.5 text-sm font-medium text-white active:scale-[0.97] transition-transform">Let's work together →</a>
  </section>
</Layout>