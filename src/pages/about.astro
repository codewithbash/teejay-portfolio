---
import Layout from "../layouts/Layout.astro";
import portrait from "../assets/teejay.png";
import { Image } from "astro:assets";



const services = [
  { n: "01", title: "Logo Design", text: "A simple, memorable mark." },
  { n: "02", title: "Brand Identity", text: "Colour, type and guidelines." },
  { n: "03", title: "Flyers & Social", text: "Graphics that get noticed." },
  { n: "04", title: "Event Design", text: "Posters and promo material." },
];
const steps = [
  { n: "STEP 1", title: "Brief", text: "We talk about your goals and audience." },
  { n: "STEP 2", title: "Concepts", text: "I send first ideas for you to react to." },
  { n: "STEP 3", title: "Refine", text: "We polish the one you like best." },
  { n: "STEP 4", title: "Deliver", text: "You get every file you need." },
];
---
<Layout title="About | Teejay's Creativerse" description="Graphic designer for brands that want to be remembered.">
  <section class="grid items-center gap-10 px-6 md:px-14 py-12 md:grid-cols-2">
    <div data-wipe class="flex h-[520px] items-center justify-center rounded-t-full bg-tint text-sm text-brand">
      <Image src={portrait} alt="Portrait of Teejay" width={900} class="h-[95%] w-auto object-contain" />
    </div>
    <div>
      <p class="mb-4 text-xs tracking-[2px] text-brand">ABOUT</p>
      <h1 class="font-serif text-5xl md:text-6xl leading-tight">Hi, I'm Teejay.</h1>
      <p class="my-6 max-w-md leading-7 text-neutral-600">
        I'm a creative graphic designer passionate about transforming ideas into eye-catching visuals. I specialize in creating impactful designs that help brands stand out, communicate their identity, and connect with their audience. At Teejay's Creativerse, creativity meets purpose through designs that inspire, engage, and leave a lasting impression.
      </p>
      <a href="/contact" class="inline-block bg-ink px-6 py-3.5 text-sm font-medium text-white active:scale-[0.97] transition-transform">Work with me →</a>
    </div>
  </section>

  <section class="px-6 md:px-14 py-12">
    <p class="mb-4 text-xs tracking-[2px] text-brand">SERVICES</p>
    <h2 class="mb-8 font-serif text-4xl">What I can do for your brand</h2>
    <div class="grid border-t border-neutral-300 md:grid-cols-4">
      {services.map((s) => (
        <div class="py-7 pr-5 text-sm text-neutral-600">
          <span class="mb-3 block text-xs tracking-[1px] text-brand">{s.n}</span>
          <h3 class="mb-2 font-serif text-2xl text-ink">{s.title}</h3>
          {s.text}
        </div>
      ))}
    </div>
  </section>

  <section class="px-6 md:px-14 pb-16">
    <p class="mb-4 text-xs tracking-[2px] text-brand">PROCESS</p>
    <h2 class="mb-8 font-serif text-4xl">How we work together</h2>
    <div class="grid border-t border-neutral-300 md:grid-cols-4">
      {steps.map((s) => (
        <div class="py-7 pr-5 text-sm text-neutral-600">
          <span class="mb-3 block text-xs tracking-[1px] text-brand">{s.n}</span>
          <h3 class="mb-2 font-serif text-2xl text-ink">{s.title}</h3>
          {s.text}
        </div>
      ))}
    </div>
  </section>
</Layout>