---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import ScrollBar from "../components/ScrollBar.astro";
import Reveal from "../components/Reveal.astro";
import Cursor from "../components/Cursor.astro";

const {
  title = "Teejay's Creativerse | Graphic Designer",
  description = "Graphic designer for brands that want to be remembered.",
  image = "/og.jpg",
} = Astro.props;

const base = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, base);
const ogImage = new URL(image, base);
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0133E2" />
    <link rel="icon" type="image/png" href="/favicon-white.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="bg-paper text-ink font-sans">
    <Cursor />
    <ScrollBar />
    <nav id="nav" class="sticky top-0 z-50 flex flex-wrap items-center justify-between gap-x-6 gap-y-3 bg-paper/90 px-6 py-5 text-sm backdrop-blur transition-transform duration-300 md:px-14">
      <a href="/" aria-label="Teejay's Creativerse, home">
        <img src="/logo-blue.png" alt="Teejay's Creativerse" class="h-9 w-auto" />
      </a>
      <div class="flex gap-5 md:gap-6">
        <a href="/">Home</a>
        <a href="/work">Work</a>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
      </div>
    </nav>
    <slot />
    <Footer />
    <Reveal />
    <script>
      const nav = document.getElementById("nav")!;
      let last = scrollY;
      addEventListener("scroll", () => {
        const y = scrollY;
        nav.style.transform = y > last && y > 120 ? "translateY(-100%)" : "translateY(0)";
        last = y;
      }, { passive: true });
    </script>
  </body>
</html>