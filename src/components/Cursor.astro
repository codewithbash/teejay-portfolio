<div id="cursor-dot" class="pointer-events-none fixed left-0 top-0 z-[100] -ml-[5px] -mt-[5px] h-2.5 w-2.5 rounded-full bg-brand opacity-0 transition-opacity duration-300"></div>
<div id="cursor-ring" class="pointer-events-none fixed left-0 top-0 z-[100] opacity-0 transition-opacity duration-300">
  <span id="cursor-ring-inner" class="-ml-5 -mt-5 block h-10 w-10 rounded-full border border-brand transition-transform duration-300 ease-out"></span>
</div>

<script>
  const dot = document.getElementById("cursor-dot")!;
  const ring = document.getElementById("cursor-ring")!;
  const inner = document.getElementById("cursor-ring-inner")!;

  const hasMouse = matchMedia("(hover: hover) and (pointer: fine)").matches;
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (hasMouse && !reduceMotion) {
    let x = 0, y = 0, rx = 0, ry = 0, visible = false;

    window.addEventListener("pointermove", (e) => {
      x = e.clientX;
      y = e.clientY;
      if (!visible) {
        rx = x; ry = y; visible = true;
        dot.classList.remove("opacity-0");
        ring.classList.remove("opacity-0");
      }
      dot.style.transform = `translate3d(${x}px, ${y}px, 0)`;
    });

    const loop = () => {
      rx += (x - rx) * 0.15;
      ry += (y - ry) * 0.15;
      ring.style.transform = `translate3d(${rx}px, ${ry}px, 0)`;
      requestAnimationFrame(loop);
    };
    loop();

    document.addEventListener("pointerover", (e) => {
      const hit = (e.target as HTMLElement).closest("a, button, summary, input, textarea, [data-cursor]");
      inner.classList.toggle("scale-150", !!hit);
      inner.classList.toggle("bg-brand/10", !!hit);
    });

    document.documentElement.addEventListener("mouseleave", () => {
      dot.classList.add("opacity-0");
      ring.classList.add("opacity-0");
      visible = false;
    });
  }
</script>
